# Required
# Populated automatically by scripts/deploy-dex-local.sh (see scripts/lib/postgres-dev.env).
DATABASE_URL=postgres://cl8y_legal:cl8y_legal@127.0.0.1:5432/dex_indexer
# Required. Opportunistic pair discovery verifies each new pair via factory Pair { asset_infos } reverse lookup (GitLab #311).
# Dev-only: empty value skips provenance with a warning; RUN_MODE=prod rejects empty factory.
FACTORY_ADDRESS=terra1factory...
# Include both hostname spellings for Vite dev: browsers treat http://localhost:5173 and http://127.0.0.1:5173 as different origins (GitLab #131).
CORS_ORIGINS=https://dex.cl8y.com,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Deployment profile: unset or dev = public LCD fallbacks OK; prod = explicit operator LCDs required
# RUN_MODE=prod

# LCD (comma-separated). In prod, set operator-controlled URLs (not the built-in public defaults).
LCD_URLS=https://terra-classic-lcd.publicnode.com,https://columbus-lcd.terra.dev

# Optional registry + tuning
FEE_DISCOUNT_ADDRESS=terra1feediscount...
# Drift-correction full reconcile (seconds). Event-driven block parsing is primary (GitLab #364). Default 86400 (24h).
# TIER_SYNC_RECONCILE_INTERVAL=86400
POLL_INTERVAL_MS=6000
API_PORT=3001
API_BIND=127.0.0.1
# IPv4-only listener by default (GitLab #282). Set API_IPV6_ENABLED=1 to allow IPv6 API_BIND values.
# API_IPV6_ENABLED=0
LCD_TIMEOUT_MS=8000
LCD_COOLDOWN_MS=30000
START_BLOCK=
# Block ingestion hardening (GitLab #236)
# BLOCK_TX_PAGE_LIMIT=100
# BLOCK_TX_MAX_PAGES=50
# BLOCK_PROCESS_MAX_RETRIES=5
# BLOCK_PROCESS_RETRY_BACKOFF_MS=2000
RATE_LIMIT_RPS=60
# Stricter per-IP limit for LCD-heavy routes (limit-book, route/solve, CG/CMC orderbook).
# Default 10. RUN_MODE=prod clamps 0 → 10 (#363). Local deploy sets 10 while RATE_LIMIT_RPS=0.
RATE_LIMIT_LCD_HEAVY_RPS=10
ORACLE_POLL_INTERVAL_MS=30000
# Mirror writer cadence for pair_reserves + resting_limit_orders (GitLab #322; default 10s)
# BOOK_SNAPSHOT_INTERVAL_MS=10000

# Router for route/solve LCD simulate (optional; enables estimated_amount_out / hybrid merge quotes)
# ROUTER_ADDRESS=terra1router...

# Native denom for USTC oracle labeling (optional)
# USTC_DENOM=uusd

# Venus Core Pool vFDUSD redeem poller (GitLab #571). Empty = do not call BSC (CI/LocalTerra).
# Server-side only — never put these in VITE_*. Failover is comma-separated.
# BSC_RPC_URLS=https://bsc-dataseed.binance.org
# VENUS_VFDUSD_POLL_INTERVAL_MS=30000

# DEX hub CW20 identity (GitLab #556 / #570). Defaults = Columbus-5 tokenlist. Override on LocalTerra.
# HUB_CUSTC_ADDRESS=terra1nap4dxh9tv35v0ynd9m4k6zt6c0dq6weszc4j5m564kjls56hu7qcr56ch
# HUB_CLUNC_ADDRESS=terra1437qslye72t7qmmahn4t5chz50r8a62g45phwkquwpyu2l62u6ksqssgdg
# HUB_UST1_ADDRESS=terra1f0eqgy9w7e5e7up97vjudqwx38tesf8ylx75x2lv3nwm0clry0pqmgfy72
# HUB_USTR_ADDRESS=terra1vy3kc0swag2rhn7jz6n72jp0l2ns0p6r6ez5grxq5uhj2rvs97fqfsetxv
# HUB_USD_TVL_FLOOR=100

# Pinned wrap-mapper for protocol fee ingest (GitLab #586). Invalid / empty → wrap/unwrap omitted.
# WRAP_MAPPER_ADDRESS=terra1xuuuhpmyd5t29ry7mydg7ra2q2phrwhx7j28nx7x9sjw6zznkumsz0nmd2

# Pinned ust1-window for mint/redeem treasury fees (GitLab #614). Same terra1 pin rules as wrap.
# Vite VITE_UST1_WINDOW_ADDRESS does not feed the indexer. Invalid / empty → ust1_mint/ust1_redeem omitted.
# UST1_WINDOW_ADDRESS=terra1zxwpzpzpleatqn39r00grau4yt29sld8pw78s7ktvjafnj5nsaxq0h3rh2

# Community tax catalog (GitLab #594 / #601). Unset → configured:false / empty list.
# Columbus-5:
# COMMUNITY_TAX_CODE_ID=11611
# COMMUNITY_TOKEN_LAUNCHER=terra126pr5323xkhwas7y03azv48sqr2fy3fxxg0sxu8xhmjdxr8v5tzqahzwze
# CMM_GOVERNANCE_ADDR=terra16j5u6ey7a84g40sr3gd94nzg5w5fm45046k9s2347qhfpwm5fr6sem3lr2
# After instances run option-2 wasm (#615 / #616). Listed 11611 stays Honest if unset.
# After #589 GO + whitelist + creates on 11619: COMMUNITY_TAX_OPTION2_CODE_IDS=11619
# COMMUNITY_TAX_OPTION2_CODE_IDS=
# COMMUNITY_TAX_OPTION2_DATA_HASHES=

# For integration tests
TEST_DATABASE_URL=postgres://cl8y_legal:cl8y_legal@127.0.0.1:5432/dex_indexer_test
