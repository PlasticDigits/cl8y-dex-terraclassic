{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Keep schema derives compatible with CosmWasm 1.5 until a coordinated migration",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "schemars"
      ],
      "allowedVersions": "<0.9"
    }
  ]
}
