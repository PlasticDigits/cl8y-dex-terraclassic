# Copy to `.env` and fill values for your network. See docs/frontend.md and docs/environment-matrix.md.

# Network: local | testnet | mainnet
VITE_NETWORK=local

# Contract addresses (run make deploy-local to get these)
VITE_FACTORY_ADDRESS=
VITE_ROUTER_ADDRESS=
VITE_FEE_DISCOUNT_ADDRESS=
VITE_CL8Y_TOKEN_ADDRESS=terra16wtml2q66g82fdkx66tap0qjkahqwp4lwq3ngtygacg5q0kzycgqvhpax3

# Wrapping contracts (display symbols cLUNC / cUSTC; mainnet Coolify values in deployments/mainnet-soft-launch/wrap-enablement.env.example)
VITE_TREASURY_ADDRESS=
VITE_WRAP_MAPPER_ADDRESS=
VITE_LUNC_C_TOKEN_ADDRESS=
VITE_USTC_C_TOKEN_ADDRESS=

# Soft-launch faucet (GitLab #473) — unset hides Mint nav; page shows unavailable if visited directly
# Production dex.cl8y.com must leave this unset (#562). LocalTerra deploy writes it into .env.local.
VITE_FAUCET_ADDRESS=
# QA-only: show gem browse on a VITE_NETWORK=mainnet build. Do not set in production images.
# VITE_SHOW_TEST_TOKENS=true
VITE_TOKEN_EMBER_ADDRESS=
VITE_TOKEN_CORAL_ADDRESS=
VITE_TOKEN_JADE_ADDRESS=
VITE_TOKEN_ONYX_ADDRESS=
VITE_TOKEN_RUBY_ADDRESS=
VITE_TOKEN_TOPAZ_ADDRESS=

# UST1 oracle window (GitLab #506) — unset hides UST1 nav; distinct from faucet /mint
# Coolify / prod columbus-5 (never LocalTerra defaults on dex.cl8y.com):
# VITE_UST1_WINDOW_ADDRESS=terra1zxwpzpzpleatqn39r00grau4yt29sld8pw78s7ktvjafnj5nsaxq0h3rh2
# VITE_UST1_TOKEN_ADDRESS=terra1f0eqgy9w7e5e7up97vjudqwx38tesf8ylx75x2lv3nwm0clry0pqmgfy72
# VITE_VFDUSD_TOKEN_ADDRESS=terra1mnl9azefrqpmu888ar2u6zrcwr80hxlt3avf4300r576cw5ar7esvxsvj3
# VITE_UST1_ORACLE_ADDRESS=terra1fmht0t6svq3n24zx03nkfja0m40zhfyyxkdcvlrkl6u7gfe6aagq4gch8n
VITE_UST1_WINDOW_ADDRESS=
VITE_UST1_TOKEN_ADDRESS=
VITE_VFDUSD_TOKEN_ADDRESS=
VITE_UST1_ORACLE_ADDRESS=

# Community tax CW20 create/manage/migrate (GitLab #593 / #601 / #620 / #626) — unset hides Create Token + Migrate Token.
# Columbus-5 Coolify (never put LocalTerra store ids on dex.cl8y.com):
# VITE_COMMUNITY_TAX_CODE_ID=11619
# VITE_COMMUNITY_TOKEN_LAUNCHER=terra126pr5323xkhwas7y03azv48sqr2fy3fxxg0sxu8xhmjdxr8v5tzqahzwze
# LocalTerra: make deploy-local writes the local store id + launcher + QA token
# (VITE_TOKEN_COMMUNITY_TAX_ADDRESS / VITE_PAIR_COMMUNITY_TAX_EMBER). SmokeUST1
# stand-in may fill VITE_UST1_TOKEN_ADDRESS. DEPLOY_SKIP_COMMUNITY_TAX=1 leaves empty.
VITE_COMMUNITY_TAX_CODE_ID=
VITE_COMMUNITY_TOKEN_LAUNCHER=
# Migrate-source allowlist (#626). Not factory AddWhitelistedCodeId. Default 6036,10184,8266,8654.
# VITE_COMMUNITY_MIGRATE_CODE_IDS=6036,10184,8266,8654
# VITE_TOKEN_COMMUNITY_TAX_ADDRESS=
# VITE_PAIR_COMMUNITY_TAX_EMBER=
# Optional wasm-admin banner compare (defaults to columbus-5 CMM).
# VITE_CMM_GOVERNANCE_ADDR=terra16j5u6ey7a84g40sr3gd94nzg5w5fm45046k9s2347qhfpwm5fr6sem3lr2
VITE_CMM_GOVERNANCE_ADDR=

# RPC endpoints (defaults per network in constants.ts; localterra uses localhost below)
VITE_TERRA_LCD_URL=http://localhost:1317
VITE_TERRA_RPC_URL=http://localhost:26657

# Indexer HTTP API (charts, volume, trade history, route/solve). Must match indexer API_PORT / deployment.
# Local: indexer CORS_ORIGINS must list every browser origin you use for the dApp (localhost vs 127.0.0.1 differ — GitLab #131).
# Soft-launch / mainnet remotes: leave the real HTTPS URL here — Vite auto-proxies via /__dev/indexer (see docs/frontend.md § Local CORS proxy).
VITE_INDEXER_URL=http://127.0.0.1:3001

# Optional: force Vite remote proxy on/off (default: auto when INDEXER/LCD URLs are non-loopback https)
# VITE_DEV_PROXY=1
# VITE_DEV_PROXY=0

# WalletConnect Project ID (required for mobile wallets in production builds — vite build fails if unset)
VITE_WC_PROJECT_ID=

# Optional: LCD sanity check that VITE_FACTORY_ADDRESS matches router on-chain factory (logs warning on mismatch)
# VITE_VERIFY_DEPLOY_ADDRESSES=true

# Optional: allow VITE_DEV_MNEMONIC in non-development vite builds (local CI only — GitLab #378)
# VITE_ALLOW_DEV_MNEMONIC=local-only

# Gas price in uluna per gas unit (must be >= chain / Station minimum; values below 28.325 are floored in code — GitLab #127)
VITE_GAS_PRICE_ULUNA=28.325

# Optional: max ms for wallet.broadcastTx / wallet.pollTx (GitLab #173; defaults 30000 / 90000)
# VITE_TERRA_TX_BROADCAST_TIMEOUT_MS=30000
# VITE_TERRA_TX_POLL_TIMEOUT_MS=90000
# Optional: Keplr/Ledger split-path sign wait (GitLab #567; default 240000). Do not set this to the 30s broadcast cap.
# VITE_TERRA_TX_SIGN_TIMEOUT_MS=240000
# VITE_TERRA_TX_SIGNING_HINT_DELAY_MS=12000

# Dev mode: enable simulated wallet (no browser extension needed)
VITE_DEV_MODE=true

# Required when VITE_DEV_MODE=true and you use the Simulated Wallet. Must be set via .env.development (gitignored) or
# the shell so it is not pulled into a production bundle. Same phrase as TEST_MNEMONIC in docker/init-chain.sh. deploy-dex-local.sh writes this to .env.development. GitLab #118.
# VITE_DEV_MNEMONIC=

# Test config
SKIP_INTEGRATION=false

# Playwright only: set on webServer in playwright.config.ts so E2E is not blocked by the first-visit risk modal
# or the connected Legal clickwrap gate (GitLab #138 / #517). Do not use in production.
# VITE_PLAYWRIGHT_E2E=true

# Open Graph / Twitter card origin baked at `vite build` (GitLab #578). Production default is
# https://dex.cl8y.com. Must be https and listed in frontend-dapp/viteOg.ts PUBLIC_ORIGIN_ALLOWLIST.
# Never derived from Host / window.location / query. Leave unset for local `vite` (relative OG URLs).
# VITE_PUBLIC_ORIGIN=https://dex.cl8y.com

# CL8Y Legal clickwrap (GitLab #517). Defaults match production; override only for staging/mock Legal.
# VITE_LEGAL_API_BASE_URL=https://api.terms.cl8y.com
# VITE_LEGAL_TERMS_BASE_URL=https://terms.cl8y.com
# VITE_LEGAL_PROPERTY=dex.cl8y.com
# Optional extra comma-separated origins for client-side redirect_uri preflight (portal still enforces allowlist).
# VITE_LEGAL_REDIRECT_ALLOWLIST=
