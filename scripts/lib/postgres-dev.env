# Local credentials are explicit; provision them through bao-exec or a private root .env.
POSTGRES_USER="${POSTGRES_USER:-dex_indexer_runtime}"
POSTGRES_PASSWORD="${POSTGRES_PASSWORD:-}"
POSTGRES_HOST="${POSTGRES_HOST:-127.0.0.1}"
POSTGRES_PORT="${POSTGRES_PORT:-5432}"
POSTGRES_DB="${POSTGRES_DB:-dex_indexer}"
POSTGRES_TEST_DB="${POSTGRES_TEST_DB:-dex_indexer_test}"
POSTGRES_SUPERUSER="${POSTGRES_SUPERUSER:-postgres}"
POSTGRES_SUPERUSER_PASSWORD="${POSTGRES_SUPERUSER_PASSWORD:-}"
POSTGRES_MIGRATOR_USER="${POSTGRES_MIGRATOR_USER:-dex_indexer_migrator}"
POSTGRES_MIGRATOR_PASSWORD="${POSTGRES_MIGRATOR_PASSWORD:-}"
POSTGRES_QA_USER="${POSTGRES_QA_USER:-dex_indexer_qa}"
POSTGRES_QA_PASSWORD="${POSTGRES_QA_PASSWORD:-}"

# Explicit scoped credentials determine local URLs; inherited DSNs cannot redirect setup.
# Encode credentials as URI components; punctuation must not change DSN meaning.
postgres_uri_component() {
  local value="$1" out='' char hex i
  local LC_ALL=C
  for ((i=0; i<${#value}; i++)); do
    char="${value:i:1}"
    case "$char" in [a-zA-Z0-9.~_-]) out+="$char" ;; *) printf -v hex '%%%02X' "'$char"; out+="$hex" ;; esac
  done
  printf '%s' "$out"
}
DATABASE_URL="postgres://$(postgres_uri_component "$POSTGRES_USER"):$(postgres_uri_component "$POSTGRES_PASSWORD")@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"
MIGRATION_DATABASE_URL="postgres://$(postgres_uri_component "$POSTGRES_MIGRATOR_USER"):$(postgres_uri_component "$POSTGRES_MIGRATOR_PASSWORD")@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"
TEST_DATABASE_URL="postgres://$(postgres_uri_component "$POSTGRES_QA_USER"):$(postgres_uri_component "$POSTGRES_QA_PASSWORD")@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_TEST_DB}"
