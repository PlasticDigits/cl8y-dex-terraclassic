# Shared local Postgres defaults (sourced by deploy + setup scripts).
# Override via repo-root `.env` or environment before `make deploy-local`.
POSTGRES_USER="${POSTGRES_USER:-cl8y_legal}"
POSTGRES_PASSWORD="${POSTGRES_PASSWORD:-cl8y_legal}"
POSTGRES_HOST="${POSTGRES_HOST:-127.0.0.1}"
POSTGRES_PORT="${POSTGRES_PORT:-5432}"
POSTGRES_DB="${POSTGRES_DB:-dex_indexer}"
POSTGRES_TEST_DB="${POSTGRES_TEST_DB:-dex_indexer_test}"
# Superuser used to bootstrap POSTGRES_USER when missing (GitLab #245). Compose creates
# cl8y_legal on first volume init; external/legacy stacks may only have postgres:postgres.
POSTGRES_SUPERUSER="${POSTGRES_SUPERUSER:-postgres}"
POSTGRES_SUPERUSER_PASSWORD="${POSTGRES_SUPERUSER_PASSWORD:-postgres}"

DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"
TEST_DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_TEST_DB}"
