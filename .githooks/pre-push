#!/usr/bin/env bash
# Block pushes that include commits whose message bodies violate email/author policy.
# Catches commits created with `git commit --no-verify` (commit-msg hook skipped).
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
# shellcheck source=.githooks/lib/validate-commit-message.sh
source "${REPO_ROOT}/.githooks/lib/validate-commit-message.sh"

remote="${1:-}"
url="${2:-}"
unset remote url

zero_oid='0000000000000000000000000000000000000000'
failed=0

while read -r local_ref local_oid remote_ref remote_oid; do
  [[ -z "${local_ref:-}" ]] && continue
  if [[ "$local_oid" == "$zero_oid" ]]; then
    continue
  fi

  hashes=""
  if [[ "$remote_oid" == "$zero_oid" ]]; then
    # New remote branch: git sends a zero remote OID. `git rev-list <sha>`
    # would walk every ancestor (including historic main) and false-reject
    # already-merged messages. Only check commits not already on origin.
    hashes="$(git rev-list "$local_oid" --not --remotes=origin 2>/dev/null || true)"
  else
    hashes="$(git rev-list "${remote_oid}..${local_oid}" 2>/dev/null || true)"
  fi

  hash=""
  while read -r hash; do
    [[ -z "$hash" ]] && continue
    if ! validate_commit_message_hash "$hash"; then
      echo "  [$hash] $(git log -1 --format='%s' "$hash")" >&2
      failed=1
    fi
  done <<< "$hashes"
done

if [[ "$failed" -ne 0 ]]; then
  echo "pre-push: REJECTED — one or more commits violate the message body policy." >&2
  echo "  Rewrite history (e.g. git rebase -i) to remove Co-authored-by / email lines." >&2
  echo "  Do not use git push --no-verify to bypass this check." >&2
  exit 1
fi
