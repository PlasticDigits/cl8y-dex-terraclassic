  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Coverage and interpretation",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "**Monitoring observations, agent-owned response.** Health/readiness requests are synthetic probes, not traffic latency or 5xx-rate SLOs. Serving liveness, indexer leadership/readiness and configured useful-quote readiness are separate. A readiness HTTP503 alone is not a serving outage. **Instrumentation gaps:** production request latency/5xx counters and provider pressure are not exported. Loki panels show bounded text-pattern counts, not traffic metrics or provider capacity gauges. `/ready` head is last observed, not an independent live chain tip. All panels share this dashboard time range. Alerts deliver to persistent internal webhook receipts; no human/email/chat/pager destination is configured."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API serving and liveness",
      "description": "1 = valid HTTP200 synthetic probe; separate from current quote admission.",
      "datasource": {
        "type": "prometheus",
        "uid": "cl8y-dex-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dex_endpoint_up{job=\"cl8y-dex-api\",service=\"cl8y-dex-terraclassic-indexer\",purpose=~\"liveness|serving\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "cl8y-dex-prometheus"
          },
          "legendFormat": "{{purpose}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bool",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
