# Downloaded LCD wasm (prefer pin files in git). Root .gitignore also has *.wasm.
codeids/*/token.wasm
codeids/*/token.wasm.tmp
codeids/*/code.json
codeids/*/code.json

# Generated decomp (wat / c / objdump can be large). Fingerprint JSON is committed when present.
codeids/*/decomp/*
!codeids/*/decomp/.gitkeep
!codeids/*/decomp/README.md
!codeids/*/decomp/fingerprint.json

# Suite logs + LocalTerra layer outputs (regenerated; do not commit)
codeids/*/logs/
codeids/*/layer-a-lcd.json
codeids/*/layer-b-lt.json
codeids/*/layer-b-tax-on.json
harness/layer-b-tax-on.json
harness/layer-b-tax-on-ephemeral.json
*.junit.xml
